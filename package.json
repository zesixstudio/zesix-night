    "glob": "^11.0.3",
    "pdf-to-img": "^7.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "vite": "^6.3.5",
    "vite-plugin-handlebars": "^2.0.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.26"
  }
