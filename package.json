{
  "name": "zesix-night",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/build-projects.mjs && node scripts/build-services.mjs",
    "import": "node scripts/import-assets.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vite build",
