<a class="skip" href="#main">Skip to content</a>
<header class="hdr" data-header>
  <div class="container-x hdr__inner">
    <a class="hdr__brand" href="/" aria-label="Zesix Studio — home">{{> logo }}</a>

    <nav class="hdr__nav glass" aria-label="Primary">
      <span class="hdr__nav-bubble" data-nav-bubble aria-hidden="true"></span>
      {{#each site.nav}}<a data-nav-link href="{{this.href}}">{{this.label}}</a>{{/each}}
    </nav>

    <div class="hdr__actions">
      <a class="btn hdr__cta" href="/contact.html" data-magnetic data-cursor="Let's talk">Let's talk</a>
      <button class="hdr__burger" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="hdr__panel" id="menu" data-menu-panel hidden>
    <nav aria-label="Mobile">
      {{#each site.nav}}<a data-nav-link href="{{this.href}}">{{this.label}}</a>{{/each}}
    </nav>
    <a class="btn" href="/contact.html">Let's talk</a>
    <div class="hdr__panel-meta">
      <a href="tel:{{site.contact.phoneDial}}">{{site.contact.phone}}</a>
      <a href="#" data-wa="{{site.contact.whatsapp}}" data-wa-msg="{{site.contact.whatsappMessage}}">WhatsApp</a>
    </div>
  </div>
</header>

<a class="wa-float glass" href="#" data-wa="{{site.contact.whatsapp}}" data-wa-msg="{{site.contact.whatsappMessage}}"
   target="_blank" rel="noopener" aria-label="Chat on WhatsApp" data-cursor="Chat">
