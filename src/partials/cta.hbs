<section class="ctaband grain">
  <div class="glow-blue" style="width:60rem;height:60rem;left:50%;top:20%;transform:translateX(-50%)"></div>
  <div class="container-x ctaband__inner" data-reveal>
    <p class="label">{{#if eyebrow}}{{eyebrow}}{{else}}Next step{{/if}}</p>
    <h2 class="text-h2">{{#if heading}}{{heading}}{{else}}Let's make your brand impossible to scroll past.{{/if}}</h2>
    <div class="ctaband__actions">
      <a class="btn" href="/contact.html" data-magnetic data-cursor="Go">{{#if cta}}{{cta}}{{else}}Start a project{{/if}}</a>
      <a class="btn btn-ghost" href="#" data-wa="{{site.contact.whatsapp}}" data-wa-msg="{{site.contact.whatsappMessage}}" data-cursor="Chat">WhatsApp us</a>
    </div>
  </div>
</section>
